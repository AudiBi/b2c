# Copier vers .env avec `npm run setup:env` (génère les secrets). Ne jamais committer .env.
# Les marqueurs __XXX__ sont remplacés par des valeurs aléatoires par scripts/init-env.mjs.

NODE_ENV=development
APP_NAME=TransitHaïti
API_PORT=3100
API_PUBLIC_URL=http://localhost:3100
WEB_PUBLIC_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173
# true si l'API est derrière un proxy de confiance (lit X-Forwarded-For)
TRUST_PROXY=false
LOG_LEVEL=info
ENABLE_DOCS=true

# --- PostgreSQL (conteneur Docker de développement) ---
POSTGRES_PORT=5442
POSTGRES_MIGRATOR_PASSWORD=__MIGRATOR_PW__
POSTGRES_APP_PASSWORD=__APP_PW__
# Rôle APPLICATIF : sans BYPASSRLS, sans propriété des tables (utilisé par l'API)
DATABASE_URL=postgresql://b2c_app:__APP_PW__@localhost:5442/b2c_dev
# Rôle de MIGRATION : propriétaire des tables (utilisé par Prisma Migrate et les seeds)
DIRECT_URL=postgresql://b2c_migrator:__MIGRATOR_PW__@localhost:5442/b2c_dev
# Base séparée pour les tests automatisés (réinitialisée à chaque exécution !)
TEST_DATABASE_URL=postgresql://b2c_app:__APP_PW__@localhost:5442/b2c_test
TEST_DIRECT_URL=postgresql://b2c_migrator:__MIGRATOR_PW__@localhost:5442/b2c_test

# --- Redis ---
REDIS_PORT=6389
REDIS_URL=redis://localhost:6389

# --- MinIO (stockage objet compatible S3, utilisé à partir de la phase 5) ---
MINIO_API_PORT=9100
MINIO_CONSOLE_PORT=9101
MINIO_ROOT_USER=b2c_minio
MINIO_ROOT_PASSWORD=__MINIO_PW__

# --- E-mail ---
# smtp : serveur SMTP (Mailpit en développement, http://localhost:8035) ; memory : tests
MAIL_TRANSPORT=smtp
SMTP_HOST=127.0.0.1
SMTP_PORT=1035
MAILPIT_UI_PORT=8035
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="TransitHaïti <no-reply@example.invalid>"

# --- Authentification ---
# Au moins 32 caractères aléatoires
JWT_ACCESS_SECRET=__JWT_SECRET__
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
COOKIE_SECURE=false
# Coût argon2id (mémoire en KiB). Ne pas descendre en production.
ARGON2_MEMORY_KIB=65536

# --- Site web (apps/web) : variables lues à la CONSTRUCTION du site (npm run build:web) ---
# Entreprise servie par le site (une construction = une entreprise) et nom de marque affiché.
VITE_COMPANY_SLUG=demo
VITE_BRAND_NAME=TransitHaïti
# URL publique du site (liens canoniques, hreflang, sitemap). Obligatoire pour une mise en ligne.
SITE_URL=http://localhost:4173

# --- Amorçage (npm run db:seed) ---
# Compte super administrateur de la plateforme : laisser vide pour ne pas le créer.
SEED_SUPERADMIN_EMAIL=
SEED_SUPERADMIN_PASSWORD=
# Mot de passe des comptes de démonstration (npm run db:seed:demo). Obligatoire pour ce script.
DEMO_PASSWORD=
