# Configuration de PRODUCTION (docker/compose.prod.yml). Copie générée par :  npm run setup:env:prod
# Les valeurs __...__ sont remplacées par des secrets aléatoires. Ne JAMAIS versionner .env.production.

# --- Site et domaine ---
# Nom de domaine public (sans https://). Le certificat TLS doit correspondre.
PUBLIC_HOST=exemple.com
# Entreprise servie par ce site : son « slug » (le site est construit pour UNE entreprise)
COMPANY_SLUG=ma-societe
# Nom de marque affiché (facultatif ; sinon la marque provisoire du code)
BRAND_NAME=
HTTP_PORT=80
HTTPS_PORT=443
# Dossier contenant fullchain.pem et privkey.pem (relatif à docker/ ou absolu)
CERTS_DIR=../certs

# --- Base de données et cache (réseau interne uniquement) ---
POSTGRES_MIGRATOR_PASSWORD=__MIGRATOR_PW__
POSTGRES_APP_PASSWORD=__APP_PW__
REDIS_PASSWORD=__REDIS_PW__

# --- Secrets de l'application (au moins 32 caractères, DIFFÉRENTS l'un de l'autre) ---
JWT_ACCESS_SECRET=__JWT_SECRET__
# Chiffre les secrets de double authentification : à SAUVEGARDER hors machine ; la perdre rend les secrets illisibles
TOTP_ENCRYPTION_KEY=__TOTP_KEY__

# --- E-mail (obligatoire : le serveur refuse de démarrer sans SMTP_HOST et MAIL_FROM) ---
SMTP_HOST=
SMTP_PORT=587
# true pour le port 465 (TLS implicite) ; false pour 587 (STARTTLS)
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="Nom de la société <no-reply@exemple.com>"

# --- Premier administrateur de la plateforme (créé une seule fois) ---
# Renseigner, déployer, puis EFFACER le mot de passe de ce fichier. Au premier accès il devra activer la double authentification.
SEED_SUPERADMIN_EMAIL=
SEED_SUPERADMIN_PASSWORD=

# --- Journalisation ---
LOG_LEVEL=info

# --- Stockage des pièces jointes : disk (volume Docker « files », à sauvegarder) ou s3 ---
STORAGE_DRIVER=disk
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false

# --- Confirmation de paiement par un prestataire (laisser vide tant qu'aucun prestataire n'est branché) ---
PAYMENT_WEBHOOK_PROVIDER=
PAYMENT_WEBHOOK_SECRET=
