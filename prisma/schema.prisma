// Schéma de la plateforme. Voir docs/DATABASE_SCHEMA.md.
//
// IMPORTANT :
// - Les politiques RLS, fonctions, CHECK, déclencheurs et GRANT sont écrits en SQL dans les migrations
//   (prisma/migrations/*/migration.sql). Prisma ne les modélise pas : relire le SQL généré par
//   `prisma migrate dev` avant de l'appliquer.
// - Toute table métier porte company_id NOT NULL (entreprise « plateforme » comprise).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Rôle applicatif (b2c_app) : soumis à la RLS
  url       = env("DATABASE_URL")
  // Rôle de migration (b2c_migrator) : propriétaire des tables, utilisé par Prisma Migrate
  directUrl = env("DIRECT_URL")
}

enum CompanyStatus {
  ACTIVE
  SUSPENDED
}

enum PaymentPolicy {
  PAY_BEFORE_SHIPMENT
  PAY_BEFORE_RELEASE
  // Les deux à la fois : payer avant l'expédition ET avant la remise
  PAY_BEFORE_BOTH
}

enum Locale {
  fr
  ht
  en
}

enum UserKind {
  PLATFORM
  STAFF
  CUSTOMER
}

enum UserStatus {
  PENDING
  ACTIVE
  DISABLED
}

enum TokenPurpose {
  EMAIL_VERIFY
  PASSWORD_RESET
  INVITE
}

enum ScopeType {
  COMPANY
  WAREHOUSE
  AGENCY
  ROUTE
}

enum ActorType {
  USER
  SYSTEM
  ANONYMOUS
}

enum CustomerType {
  INDIVIDUAL
  BUSINESS
}

enum AddressKind {
  PERSONAL
  DELIVERY
}

enum BeneficiaryStatus {
  ACTIVE
  REVOKED
}

enum WarehouseStatus {
  ACTIVE
  INACTIVE
}

enum TransportMode {
  AIR
  SEA
}

enum IdempotencyStatus {
  COMPLETED
}

model Company {
  id                 String        @id @default(uuid(7)) @db.Uuid
  name               String
  slug               String        @unique
  trackingPrefix     String?       @unique @map("tracking_prefix")
  customerCodePrefix String?       @map("customer_code_prefix")
  defaultCurrency    String        @default("USD") @map("default_currency") @db.Char(3)
  defaultLocale      Locale        @default(fr) @map("default_locale")
  paymentPolicy      PaymentPolicy @default(PAY_BEFORE_SHIPMENT) @map("payment_policy")
  status             CompanyStatus @default(ACTIVE)
  createdAt          DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  settings              CompanySetting[]
  users                 User[]
  sessions              Session[]
  verificationTokens    VerificationToken[]
  roles                 Role[]
  rolePermissions       RolePermission[]
  userRoles             UserRole[]
  auditLogs             AuditLog[]
  idempotencyKeys       IdempotencyKey[]
  counters              Counter[]
  customers             Customer[]
  customerMembers       CustomerMember[]
  customerAddresses     CustomerAddress[]
  beneficiaries         Beneficiary[]
  warehouses            Warehouse[]
  receivingAddresses    ReceivingAddress[]
  packageCategories     PackageCategory[]
  packageGroups         PackageGroup[]
  packages              Package[]
  packageEvents         PackageEvent[]
  packageHolds          PackageHold[]
  prealerts             Prealert[]
  rateCards             RateCard[]
  customsItems          CustomsItem[]
  expenses              Expense[]
  bankDeposits          BankDeposit[]
  pettyCashEntries      PettyCashEntry[]
  bankDepositSessions   BankDepositSession[]
  referrers             Referrer[]
  customerReferrers     CustomerReferrer[]
  referrerPayouts       ReferrerPayout[]
  claimCompensations    ClaimCompensation[]
  proformas             Proforma[]
  packageCustomsLines   PackageCustomsLine[]
  rateRules             RateRule[]
  rateSurcharges        RateSurcharge[]
  quotes                Quote[]
  fileObjects           FileObject[]
  warehouseLocations    WarehouseLocation[]
  warehouseMovements    WarehouseMovement[]
  agencies              Agency[]
  shipments             Shipment[]
  shipmentPackages      ShipmentPackage[]
  shipmentEvents        ShipmentEvent[]
  invoices              Invoice[]
  invoiceLines          InvoiceLine[]
  invoicePackages       InvoicePackage[]
  creditNotes           CreditNote[]
  payments              Payment[]
  receipts              Receipt[]
  refunds               Refund[]
  cashSessions          CashSession[]
  webhookEvents         ProviderWebhookEvent[]
  notificationTemplates NotificationTemplate[]
  outboxEvents          OutboxEvent[]
  notifications         Notification[]
  routes                Route[]
  routeStops            RouteStop[]
  deliveryAttempts      DeliveryAttempt[]
  handoverCodes         HandoverCode[]
  claims                Claim[]
  claimMessages         ClaimMessage[]
  totpRecoveryCodes     TotpRecoveryCode[]

  @@map("companies")
}

model CompanySetting {
  companyId String   @map("company_id") @db.Uuid
  key       String
  value     Json
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  company Company @relation(fields: [companyId], references: [id])

  @@id([companyId, key])
  @@map("company_settings")
}

model User {
  id                String     @id @default(uuid(7)) @db.Uuid
  companyId         String     @map("company_id") @db.Uuid
  kind              UserKind
  email             String
  phone             String?
  firstName         String     @map("first_name")
  lastName          String     @map("last_name")
  businessName      String?    @map("business_name")
  passwordHash      String?    @map("password_hash")
  passwordChangedAt DateTime?  @map("password_changed_at") @db.Timestamptz(6)
  locale            Locale     @default(fr)
  status            UserStatus @default(PENDING)
  emailVerifiedAt   DateTime?  @map("email_verified_at") @db.Timestamptz(6)
  phoneVerifiedAt   DateTime?  @map("phone_verified_at") @db.Timestamptz(6)
  // Authentification à deux facteurs (TOTP) : secret chiffré (AES-256-GCM) ; actif seulement une fois `totpEnabledAt` renseigné
  totpSecretEnc     String?    @map("totp_secret_enc")
  totpEnabledAt     DateTime?  @map("totp_enabled_at") @db.Timestamptz(6)
  // Dernière période de 30 s acceptée : un code ne sert qu'une fois (anti-rejeu)
  totpLastStep      BigInt?    @map("totp_last_step")
  lastLoginAt       DateTime?  @map("last_login_at") @db.Timestamptz(6)
  createdAt         DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)

  company            Company             @relation(fields: [companyId], references: [id])
  sessions           Session[]
  verificationTokens VerificationToken[]
  userRoles          UserRole[]
  recoveryCodes      TotpRecoveryCode[]
  drivenRoutes       Route[]
  assignedClaims     Claim[]
  customer           Customer?
  teamMembership     CustomerMember?

  @@unique([companyId, email])
  @@unique([id, companyId])
  @@index([companyId, status])
  @@map("users")
}

model Session {
  id          String    @id @default(uuid(7)) @db.Uuid
  companyId   String    @map("company_id") @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  // Toutes les sessions issues d'une même connexion partagent la famille ; la réutilisation d'un
  // jeton déjà tourné révoque toute la famille.
  familyId    String    @map("family_id") @db.Uuid
  refreshHash String    @map("refresh_hash")
  ip          String?
  userAgent   String?   @map("user_agent")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  expiresAt   DateTime  @map("expires_at") @db.Timestamptz(6)
  rotatedAt   DateTime? @map("rotated_at") @db.Timestamptz(6)
  revokedAt   DateTime? @map("revoked_at") @db.Timestamptz(6)

  company Company @relation(fields: [companyId], references: [id])
  user    User    @relation(fields: [userId, companyId], references: [id, companyId])

  @@index([userId])
  @@index([familyId])
  @@index([companyId, expiresAt])
  @@map("sessions")
}

model VerificationToken {
  id        String       @id @default(uuid(7)) @db.Uuid
  companyId String       @map("company_id") @db.Uuid
  userId    String       @map("user_id") @db.Uuid
  purpose   TokenPurpose
  // Seul le condensé SHA-256 du secret est conservé
  tokenHash String       @unique @map("token_hash")
  expiresAt DateTime     @map("expires_at") @db.Timestamptz(6)
  usedAt    DateTime?    @map("used_at") @db.Timestamptz(6)
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)

  company Company @relation(fields: [companyId], references: [id])
  user    User    @relation(fields: [userId, companyId], references: [id, companyId])

  @@index([userId, purpose])
  @@map("verification_tokens")
}

// Rôles système : company_id = entreprise « plateforme » (lisibles par toutes les entreprises).
model Role {
  id          String    @id @default(uuid(7)) @db.Uuid
  companyId   String    @map("company_id") @db.Uuid
  code        String
  name        String
  description String?
  isSystem    Boolean   @default(false) @map("is_system")
  // Portée unique d'un rôle PERSONNALISÉ (les rôles système ont plusieurs portées possibles, définies dans le code)
  scopeType   ScopeType @default(COMPANY) @map("scope_type")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  company     Company          @relation(fields: [companyId], references: [id])
  permissions RolePermission[]
  userRoles   UserRole[]

  @@unique([companyId, code])
  @@map("roles")
}

// Référentiel global défini par le code (packages/shared) ; synchronisé par `npm run db:seed`.
model Permission {
  code        String @id
  description String

  rolePermissions RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId         String @map("role_id") @db.Uuid
  permissionCode String @map("permission_code")
  companyId      String @map("company_id") @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionCode], references: [code])
  company    Company    @relation(fields: [companyId], references: [id])

  @@id([roleId, permissionCode])
  @@map("role_permissions")
}

model UserRole {
  id        String    @id @default(uuid(7)) @db.Uuid
  companyId String    @map("company_id") @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  roleId    String    @map("role_id") @db.Uuid
  scopeType ScopeType @default(COMPANY) @map("scope_type")
  scopeId   String?   @map("scope_id") @db.Uuid
  // 'COMPANY' ou '<TYPE>:<uuid>' : clé d'unicité sans valeur NULL
  scopeKey  String    @map("scope_key")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  createdBy String?   @map("created_by") @db.Uuid

  company Company @relation(fields: [companyId], references: [id])
  user    User    @relation(fields: [userId, companyId], references: [id, companyId])
  role    Role    @relation(fields: [roleId], references: [id])

  @@unique([userId, roleId, scopeKey])
  @@index([companyId, userId])
  @@map("user_roles")
}

// Journal en ajout seul : le rôle applicatif n'a que INSERT et SELECT, et un déclencheur
// refuse tout UPDATE / DELETE.
model AuditLog {
  id          String    @id @default(uuid(7)) @db.Uuid
  companyId   String    @map("company_id") @db.Uuid
  actorUserId String?   @map("actor_user_id") @db.Uuid
  actorType   ActorType @map("actor_type")
  action      String
  entityType  String?   @map("entity_type")
  entityId    String?   @map("entity_id") @db.Uuid
  before      Json?
  after       Json?
  ip          String?
  requestId   String?   @map("request_id")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  company Company @relation(fields: [companyId], references: [id])

  @@index([companyId, entityType, entityId])
  @@index([companyId, createdAt])
  @@index([companyId, action])
  @@map("audit_log")
}

model IdempotencyKey {
  companyId      String            @map("company_id") @db.Uuid
  scope          String
  key            String
  requestHash    String            @map("request_hash")
  status         IdempotencyStatus @default(COMPLETED)
  responseStatus Int?              @map("response_status")
  response       Json?
  createdAt      DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)

  company Company @relation(fields: [companyId], references: [id])

  @@id([companyId, scope, key])
  @@map("idempotency_keys")
}

// Compteurs sans trou (factures, reçus, codes clients) ; incrément sous verrou de ligne.
model Counter {
  companyId String @map("company_id") @db.Uuid
  name      String
  year      Int    @default(0)
  value     Int    @default(0)

  company Company @relation(fields: [companyId], references: [id])

  @@id([companyId, name, year])
  @@map("counters")
}

// Profil client d'un utilisateur de type CUSTOMER. Le code client identifie les colis reçus en entrepôt.
// Membre de l'équipe d'un compte professionnel : un utilisateur (jamais propriétaire lui-même) rattaché à UN compte.
// Son rôle (lecteur ou opérateur) est porté par user_roles ; ses droits sont limités (voir packages/shared/src/roles.ts).
model CustomerMember {
  id         String   @id @default(uuid(7)) @db.Uuid
  companyId  String   @map("company_id") @db.Uuid
  customerId String   @map("customer_id") @db.Uuid
  userId     String   @unique @map("user_id") @db.Uuid
  invitedBy  String?  @map("invited_by") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  company  Company  @relation(fields: [companyId], references: [id])
  customer Customer @relation(fields: [customerId, companyId], references: [id, companyId])
  user     User     @relation(fields: [userId, companyId], references: [id, companyId])

  @@unique([userId, companyId])
  @@index([companyId, customerId])
  @@map("customer_members")
}

model Customer {
  id                String       @id @default(uuid(7)) @db.Uuid
  companyId         String       @map("company_id") @db.Uuid
  userId            String       @unique @map("user_id") @db.Uuid
  customerType      CustomerType @map("customer_type")
  customerCode      String       @map("customer_code")
  // Canaux de notification souhaités : { email, whatsapp, inApp }
  notificationPrefs Json         @default("{\"email\": true, \"whatsapp\": false, \"inApp\": true}") @map("notification_prefs")
  createdAt         DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  company            Company            @relation(fields: [companyId], references: [id])
  user               User               @relation(fields: [userId, companyId], references: [id, companyId])
  addresses          CustomerAddress[]
  beneficiaries      Beneficiary[]
  receivingAddresses ReceivingAddress[]
  packages           Package[]
  packageGroups      PackageGroup[]
  prealerts          Prealert[]
  quotes             Quote[]
  invoices           Invoice[]
  payments           Payment[]
  notifications      Notification[]
  routeStops         RouteStop[]
  handoverCodes      HandoverCode[]
  claims             Claim[]
  members            CustomerMember[]
  proformas          Proforma[]
  referral           CustomerReferrer?

  @@unique([companyId, customerCode])
  @@unique([id, companyId])
  @@unique([userId, companyId])
  @@map("customers")
}

model CustomerAddress {
  id            String      @id @default(uuid(7)) @db.Uuid
  companyId     String      @map("company_id") @db.Uuid
  customerId    String      @map("customer_id") @db.Uuid
  kind          AddressKind
  label         String
  recipientName String      @map("recipient_name")
  phone         String?
  line1         String
  line2         String?
  city          String
  region        String?
  country       String      @db.Char(2)
  postalCode    String?     @map("postal_code")
  instructions  String?
  isDefault     Boolean     @default(false) @map("is_default")
  createdAt     DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)

  company  Company  @relation(fields: [companyId], references: [id])
  customer Customer @relation(fields: [customerId, companyId], references: [id, companyId])

  @@index([customerId])
  @@map("customer_addresses")
}

// Personne autorisée à retirer un colis pour le client. Seuls les 4 derniers caractères de la pièce d'identité sont conservés.
model Beneficiary {
  id              String            @id @default(uuid(7)) @db.Uuid
  companyId       String            @map("company_id") @db.Uuid
  customerId      String            @map("customer_id") @db.Uuid
  fullName        String            @map("full_name")
  idDocumentType  String?           @map("id_document_type")
  idDocumentLast4 String?           @map("id_document_last4")
  phone           String?
  validFrom       DateTime?         @map("valid_from") @db.Date
  validTo         DateTime?         @map("valid_to") @db.Date
  status          BeneficiaryStatus @default(ACTIVE)
  createdAt       DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)

  company  Company  @relation(fields: [companyId], references: [id])
  customer Customer @relation(fields: [customerId, companyId], references: [id, companyId])

  @@index([customerId, status])
  @@map("beneficiaries")
}

// Entrepôt de réception. addressTemplate : lignes avec {customerName}, {customerCode}, {mode}.
model Warehouse {
  id              String          @id @default(uuid(7)) @db.Uuid
  companyId       String          @map("company_id") @db.Uuid
  reference       String
  name            String
  country         String          @db.Char(2)
  city            String
  addressLine     String          @map("address_line")
  // Rendre l'adresse physique visible sur le site public
  publicVisible   Boolean         @default(true) @map("public_visible")
  addressTemplate Json            @map("address_template")
  // Incrémentée quand le modèle d'adresse change : les adresses clients sont régénérées à la demande
  version         Int             @default(1)
  timezone        String          @default("UTC")
  status          WarehouseStatus @default(ACTIVE)
  createdAt       DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)

  company            Company             @relation(fields: [companyId], references: [id])
  receivingAddresses ReceivingAddress[]
  packages           Package[]
  prealerts          Prealert[]
  locations          WarehouseLocation[]
  shipments          Shipment[]

  @@unique([companyId, reference])
  @@unique([id, companyId])
  @@map("warehouses")
}

// Adresse de réception personnalisée : une par (client, entrepôt, mode de transport).
model ReceivingAddress {
  id               String        @id @default(uuid(7)) @db.Uuid
  companyId        String        @map("company_id") @db.Uuid
  customerId       String        @map("customer_id") @db.Uuid
  warehouseId      String        @map("warehouse_id") @db.Uuid
  transportMode    TransportMode @map("transport_mode")
  lines            Json
  warehouseVersion Int           @map("warehouse_version")
  generatedAt      DateTime      @default(now()) @map("generated_at") @db.Timestamptz(6)

  company   Company   @relation(fields: [companyId], references: [id])
  customer  Customer  @relation(fields: [customerId, companyId], references: [id, companyId])
  warehouse Warehouse @relation(fields: [warehouseId, companyId], references: [id, companyId])

  @@unique([customerId, warehouseId, transportMode])
  @@index([companyId, warehouseId])
  @@map("receiving_addresses")
}

// =====================================================================================
// Phase 5 : colis, préalertes, tarification, fichiers
// =====================================================================================

enum PackageStatus {
  PREALERT_CREATED
  AWAITING_RECEIPT
  RECEIVED_AT_WAREHOUSE
  UNDER_INSPECTION
  REGISTERED_WEIGHED
  AWAITING_PAYMENT
  READY_TO_SHIP
  IN_TRANSIT
  ARRIVED_DESTINATION
  IN_CUSTOMS
  RECEIVED_AT_AGENCY
  READY_FOR_PICKUP
  OUT_FOR_DELIVERY
  DELIVERED
  ON_HOLD
  RETURNED
  CANCELLED
}

enum EventVisibility {
  PUBLIC
  PRIVATE
}

enum PrealertStatus {
  OPEN
  MATCHED_AUTO
  MATCHED_MANUAL
  CANCELLED
}

enum HoldReasonCode {
  DAMAGED
  UNIDENTIFIED
  SUSPICIOUS_CONTENT
  PROHIBITED_ITEM
  CUSTOMS
  OTHER
}

// Ce sur quoi une tranche de grille est calculée
enum PricingBasis {
  WEIGHT
  VOLUME
  UNIT
}

enum RoundingMode {
  NONE
  UP
  NEAREST
}

enum RateCardStatus {
  DRAFT
  ACTIVE
  RETIRED
}

enum WeightUnit {
  KG
  LB
}

enum DimensionUnit {
  CM
  IN
}

enum SurchargeKind {
  SURCHARGE
  TAX
  INSURANCE
}

enum SurchargeMethod {
  FLAT
  PERCENT_OF_FREIGHT
  PERCENT_OF_DECLARED_VALUE
  PERCENT_OF_SUBTOTAL
}

enum FileOwnerType {
  PREALERT
  PACKAGE
}

enum FileKind {
  PHOTO
  INVOICE
  DOCUMENT
}

model PackageCategory {
  id         String   @id @default(uuid(7)) @db.Uuid
  companyId  String   @map("company_id") @db.Uuid
  code       String
  name       Json
  restricted Boolean  @default(false)
  active     Boolean  @default(true)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  company   Company    @relation(fields: [companyId], references: [id])
  packages  Package[]
  rateRules RateRule[]

  @@unique([companyId, code])
  @@unique([id, companyId])
  @@map("package_categories")
}

model PackageGroup {
  id         String   @id @default(uuid(7)) @db.Uuid
  companyId  String   @map("company_id") @db.Uuid
  customerId String   @map("customer_id") @db.Uuid
  reference  String
  createdBy  String?  @map("created_by") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  company  Company   @relation(fields: [companyId], references: [id])
  customer Customer  @relation(fields: [customerId, companyId], references: [id, companyId])
  packages Package[]

  @@unique([companyId, reference])
  @@unique([id, companyId])
  @@map("package_groups")
}

model Package {
  id                   String         @id @default(uuid(7)) @db.Uuid
  companyId            String         @map("company_id") @db.Uuid
  // Unique dans TOUTE la plateforme : le suivi public n'a pas besoin de connaître l'entreprise
  trackingNumber       String         @unique @map("tracking_number")
  // Absent tant que le colis n'est pas identifié
  customerId           String?        @map("customer_id") @db.Uuid
  senderName           String?        @map("sender_name")
  recipientName        String?        @map("recipient_name")
  quantity             Int            @default(1)
  // Coût d'achat figé à la pesée : jamais dans les réponses destinées aux clients
  costAmount           Decimal?       @map("cost_amount") @db.Decimal(14, 2)
  costCurrency         String?        @map("cost_currency") @db.Char(3)
  recipientPhone       String?        @map("recipient_phone")
  recipientCity        String?        @map("recipient_city")
  // Ancien numéro de suivi (import de l'outil de gestion)
  legacyTrackingNumber String?        @map("legacy_tracking_number")
  createdAtCounter     Boolean        @default(false) @map("created_at_counter")
  originWarehouseId    String         @map("origin_warehouse_id") @db.Uuid
  originCountry        String         @map("origin_country") @db.Char(2)
  originCity           String         @map("origin_city")
  destinationCountry   String         @map("destination_country") @db.Char(2)
  destinationCity      String?        @map("destination_city")
  transportMode        TransportMode? @map("transport_mode")
  // Forme normalisée (majuscules, sans espaces) pour le rapprochement
  supplierTracking     String?        @map("supplier_tracking")
  status               PackageStatus
  previousStatus       PackageStatus? @map("previous_status")
  // Mesures réelles, stockées en unités canoniques (kg, cm)
  actualWeightKg       Decimal?       @map("actual_weight_kg") @db.Decimal(10, 3)
  lengthCm             Decimal?       @map("length_cm") @db.Decimal(8, 2)
  widthCm              Decimal?       @map("width_cm") @db.Decimal(8, 2)
  heightCm             Decimal?       @map("height_cm") @db.Decimal(8, 2)
  // Poids calculés selon la grille appliquée, dans l'unité de cette grille
  volumetricWeight     Decimal?       @map("volumetric_weight") @db.Decimal(12, 3)
  billableWeight       Decimal?       @map("billable_weight") @db.Decimal(12, 3)
  weightUnit           WeightUnit?    @map("weight_unit")
  rateCardId           String?        @map("rate_card_id") @db.Uuid
  // Détail du calcul au moment de la pesée (grille, étapes, lignes) : montant DÉFINITIF issu des mesures réelles
  pricingSnapshot      Json?          @map("pricing_snapshot")
  shippingFee          Decimal?       @map("shipping_fee") @db.Decimal(14, 2)
  extraFees            Decimal?       @map("extra_fees") @db.Decimal(14, 2)
  feeCurrency          String?        @map("fee_currency") @db.Char(3)
  contentDescription   String?        @map("content_description")
  declaredValue        Decimal?       @map("declared_value") @db.Decimal(14, 2)
  declaredCurrency     String?        @map("declared_currency") @db.Char(3)
  insured              Boolean        @default(false)
  categoryId           String?        @map("category_id") @db.Uuid
  groupId              String?        @map("group_id") @db.Uuid
  // Emplacement de rangement dans l'entrepôt d'origine (absent : pas de rangement précis, ou colis parti)
  locationId           String?        @map("location_id") @db.Uuid
  // Agence de retrait en destination
  destinationAgencyId  String?        @map("destination_agency_id") @db.Uuid
  receivedAt           DateTime?      @map("received_at") @db.Timestamptz(6)
  registeredAt         DateTime?      @map("registered_at") @db.Timestamptz(6)
  // Incrémenté à chaque changement : détection des modifications concurrentes
  version              Int            @default(1)
  createdBy            String?        @map("created_by") @db.Uuid
  createdAt            DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)

  company          Company              @relation(fields: [companyId], references: [id])
  customer         Customer?            @relation(fields: [customerId, companyId], references: [id, companyId])
  warehouse        Warehouse            @relation(fields: [originWarehouseId, companyId], references: [id, companyId])
  category         PackageCategory?     @relation(fields: [categoryId, companyId], references: [id, companyId])
  group            PackageGroup?        @relation(fields: [groupId, companyId], references: [id, companyId])
  location         WarehouseLocation?   @relation(fields: [locationId, companyId], references: [id, companyId])
  agency           Agency?              @relation(fields: [destinationAgencyId, companyId], references: [id, companyId])
  shipmentLinks    ShipmentPackage[]
  invoiceLines     InvoiceLine[]
  invoicePackage   InvoicePackage?
  routeStops       RouteStop[]
  customsLines     PackageCustomsLine[]
  proformas        Proforma[]
  deliveryAttempts DeliveryAttempt[]
  handoverCodes    HandoverCode[]
  claims           Claim[]
  movements        WarehouseMovement[]
  events           PackageEvent[]
  holds            PackageHold[]
  prealert         Prealert?

  @@unique([id, companyId])
  @@index([companyId, status])
  @@index([companyId, customerId])
  @@index([companyId, supplierTracking])
  @@index([companyId, originWarehouseId, status])
  @@map("packages")
}

// Historique en ajout seul ; chaque changement de statut y laisse une ligne dans la MÊME transaction
// (un déclencheur différé le vérifie).
model PackageEvent {
  id            String          @id @default(uuid(7)) @db.Uuid
  companyId     String          @map("company_id") @db.Uuid
  packageId     String          @map("package_id") @db.Uuid
  fromStatus    PackageStatus?  @map("from_status")
  toStatus      PackageStatus?  @map("to_status")
  eventType     String          @map("event_type")
  actorUserId   String?         @map("actor_user_id") @db.Uuid
  reason        String?
  visibility    EventVisibility @default(PUBLIC)
  // Ville de l'entrepôt ou de l'agence au moment de l'événement (affichable publiquement)
  locationLabel String?         @map("location_label")
  data          Json?
  txid          BigInt          @default(dbgenerated("txid_current()"))
  occurredAt    DateTime        @default(now()) @map("occurred_at") @db.Timestamptz(6)

  company Company @relation(fields: [companyId], references: [id])
  package Package @relation(fields: [packageId, companyId], references: [id, companyId])

  @@index([packageId, occurredAt])
  @@index([packageId, txid])
  @@map("package_events")
}

model PackageHold {
  id         String         @id @default(uuid(7)) @db.Uuid
  companyId  String         @map("company_id") @db.Uuid
  packageId  String         @map("package_id") @db.Uuid
  reasonCode HoldReasonCode @map("reason_code")
  note       String?
  openedBy   String?        @map("opened_by") @db.Uuid
  openedAt   DateTime       @default(now()) @map("opened_at") @db.Timestamptz(6)
  releasedBy String?        @map("released_by") @db.Uuid
  releasedAt DateTime?      @map("released_at") @db.Timestamptz(6)

  company Company @relation(fields: [companyId], references: [id])
  package Package @relation(fields: [packageId, companyId], references: [id, companyId])

  @@index([packageId])
  @@map("package_holds")
}

// Achat déclaré par le client. Crée un colis « attendu » (PREALERT_CREATED puis AWAITING_RECEIPT).
model Prealert {
  id               String         @id @default(uuid(7)) @db.Uuid
  companyId        String         @map("company_id") @db.Uuid
  customerId       String         @map("customer_id") @db.Uuid
  packageId        String         @unique @map("package_id") @db.Uuid
  storeName        String         @map("store_name")
  orderNumber      String?        @map("order_number")
  supplierTracking String?        @map("supplier_tracking")
  warehouseId      String         @map("warehouse_id") @db.Uuid
  transportMode    TransportMode  @map("transport_mode")
  purchaseAmount   Decimal        @map("purchase_amount") @db.Decimal(14, 2)
  purchaseCurrency String         @map("purchase_currency") @db.Char(3)
  description      String
  status           PrealertStatus @default(OPEN)
  matchedByUserId  String?        @map("matched_by_user_id") @db.Uuid
  matchedAt        DateTime?      @map("matched_at") @db.Timestamptz(6)
  createdAt        DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)

  company   Company   @relation(fields: [companyId], references: [id])
  customer  Customer  @relation(fields: [customerId, companyId], references: [id, companyId])
  package   Package   @relation(fields: [packageId, companyId], references: [id, companyId])
  warehouse Warehouse @relation(fields: [warehouseId, companyId], references: [id, companyId])

  @@unique([packageId, companyId])
  @@index([companyId, customerId, status])
  @@index([companyId, supplierTracking])
  @@map("prealerts")
}

// Grille tarifaire. Une fois ACTIVE elle est immuable ; modifier = créer une nouvelle grille.
model RateCard {
  id                 String         @id @default(uuid(7)) @db.Uuid
  companyId          String         @map("company_id") @db.Uuid
  name               String
  transportMode      TransportMode  @map("transport_mode")
  originCountry      String         @map("origin_country") @db.Char(2)
  destinationCountry String         @map("destination_country") @db.Char(2)
  currency           String         @db.Char(3)
  weightUnit         WeightUnit     @map("weight_unit")
  dimensionUnit      DimensionUnit  @map("dimension_unit")
  volumetricDivisor  Decimal        @map("volumetric_divisor") @db.Decimal(12, 4)
  minBillableWeight  Decimal        @default(0) @map("min_billable_weight") @db.Decimal(12, 3)
  roundingMode       RoundingMode   @default(NONE) @map("rounding_mode")
  roundingStep       Decimal        @default(1) @map("rounding_step") @db.Decimal(12, 3)
  validFrom          DateTime       @map("valid_from") @db.Date
  validTo            DateTime?      @map("valid_to") @db.Date
  status             RateCardStatus @default(DRAFT)
  version            Int            @default(1)
  createdBy          String?        @map("created_by") @db.Uuid
  createdAt          DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)

  company    Company         @relation(fields: [companyId], references: [id])
  rules      RateRule[]
  surcharges RateSurcharge[]
  quotes     Quote[]
  proformas  Proforma[]

  @@unique([id, companyId])
  @@index([companyId, status, transportMode, originCountry, destinationCountry])
  @@map("rate_cards")
}

model RateRule {
  id                String       @id @default(uuid(7)) @db.Uuid
  companyId         String       @map("company_id") @db.Uuid
  rateCardId        String       @map("rate_card_id") @db.Uuid
  categoryId        String?      @map("category_id") @db.Uuid
  weightFrom        Decimal      @map("weight_from") @db.Decimal(12, 3)
  weightTo          Decimal?     @map("weight_to") @db.Decimal(12, 3)
  pricePerUnit      Decimal      @map("price_per_unit") @db.Decimal(14, 4)
  flatFee           Decimal      @default(0) @map("flat_fee") @db.Decimal(14, 2)
  minCharge         Decimal      @default(0) @map("min_charge") @db.Decimal(14, 2)
  // WEIGHT : poids facturable ; VOLUME : pieds cubes (ou m³) ; UNIT : nombre d'unités (barils)
  basis             PricingBasis @default(WEIGHT)
  volumetricDivisor Decimal?     @map("volumetric_divisor") @db.Decimal(12, 4)
  // Coût d'achat par unité de base (réservé à cost:read)
  unitCost          Decimal?     @map("unit_cost") @db.Decimal(14, 4)

  company  Company          @relation(fields: [companyId], references: [id])
  rateCard RateCard         @relation(fields: [rateCardId, companyId], references: [id, companyId])
  category PackageCategory? @relation(fields: [categoryId, companyId], references: [id, companyId])

  @@index([rateCardId])
  @@map("rate_rules")
}

model RateSurcharge {
  id         String          @id @default(uuid(7)) @db.Uuid
  companyId  String          @map("company_id") @db.Uuid
  rateCardId String          @map("rate_card_id") @db.Uuid
  code       String
  name       Json
  kind       SurchargeKind
  method     SurchargeMethod
  value      Decimal         @db.Decimal(14, 4)
  optional   Boolean         @default(false)

  company  Company  @relation(fields: [companyId], references: [id])
  rateCard RateCard @relation(fields: [rateCardId, companyId], references: [id, companyId])

  @@unique([rateCardId, code])
  @@map("rate_surcharges")
}

// Estimations enregistrées pour les clients connectés (jamais pour les visiteurs anonymes).
model Quote {
  id         String   @id @default(uuid(7)) @db.Uuid
  companyId  String   @map("company_id") @db.Uuid
  customerId String?  @map("customer_id") @db.Uuid
  rateCardId String   @map("rate_card_id") @db.Uuid
  input      Json
  result     Json
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  company  Company   @relation(fields: [companyId], references: [id])
  customer Customer? @relation(fields: [customerId, companyId], references: [id, companyId])
  rateCard RateCard  @relation(fields: [rateCardId, companyId], references: [id, companyId])

  @@index([companyId, customerId, createdAt])
  @@map("quotes")
}

// Pièces jointes (photos, factures). Le contenu est vérifié avant enregistrement ; la clé de stockage
// commence toujours par companies/<entreprise>/.
model FileObject {
  id           String        @id @default(uuid(7)) @db.Uuid
  companyId    String        @map("company_id") @db.Uuid
  ownerType    FileOwnerType @map("owner_type")
  ownerId      String        @map("owner_id") @db.Uuid
  kind         FileKind
  storageKey   String        @unique @map("storage_key")
  originalName String        @map("original_name")
  mimeType     String        @map("mime_type")
  sizeBytes    Int           @map("size_bytes")
  sha256       String
  uploadedBy   String?       @map("uploaded_by") @db.Uuid
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)

  company Company @relation(fields: [companyId], references: [id])

  @@index([companyId, ownerType, ownerId])
  @@map("file_objects")
}

// =============================================================================================
// Phase 6 : emplacements, mouvements, agences, lots de transport
// =============================================================================================

enum LocationKind {
  ZONE
  SHELF
  BIN
}

enum MovementKind {
  IN
  MOVE
  OUT
}

enum AgencyKind {
  AGENCY
  PICKUP_POINT
}

enum ShipmentStatus {
  OPEN
  DISPATCHED
  ARRIVED
  IN_CUSTOMS
  CLOSED
  CANCELLED
}

model WarehouseLocation {
  id          String          @id @default(uuid(7)) @db.Uuid
  companyId   String          @map("company_id") @db.Uuid
  warehouseId String          @map("warehouse_id") @db.Uuid
  code        String
  kind        LocationKind    @default(SHELF)
  status      WarehouseStatus @default(ACTIVE)
  createdAt   DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)

  company       Company             @relation(fields: [companyId], references: [id])
  warehouse     Warehouse           @relation(fields: [warehouseId, companyId], references: [id, companyId])
  packages      Package[]
  movementsFrom WarehouseMovement[] @relation("MovementFrom")
  movementsTo   WarehouseMovement[] @relation("MovementTo")

  @@unique([warehouseId, code])
  @@unique([id, companyId])
  @@map("warehouse_locations")
}

// Journal des mouvements en entrepôt : ajout seul.
model WarehouseMovement {
  id             String       @id @default(uuid(7)) @db.Uuid
  companyId      String       @map("company_id") @db.Uuid
  packageId      String       @map("package_id") @db.Uuid
  warehouseId    String       @map("warehouse_id") @db.Uuid
  fromLocationId String?      @map("from_location_id") @db.Uuid
  toLocationId   String?      @map("to_location_id") @db.Uuid
  kind           MovementKind
  actorUserId    String?      @map("actor_user_id") @db.Uuid
  note           String?
  occurredAt     DateTime     @default(now()) @map("occurred_at") @db.Timestamptz(6)

  company      Company            @relation(fields: [companyId], references: [id])
  package      Package            @relation(fields: [packageId, companyId], references: [id, companyId])
  fromLocation WarehouseLocation? @relation("MovementFrom", fields: [fromLocationId, companyId], references: [id, companyId])
  toLocation   WarehouseLocation? @relation("MovementTo", fields: [toLocationId, companyId], references: [id, companyId])

  @@index([companyId, packageId, occurredAt])
  @@map("warehouse_movements")
}

model Agency {
  id            String          @id @default(uuid(7)) @db.Uuid
  companyId     String          @map("company_id") @db.Uuid
  code          String
  name          String
  kind          AgencyKind      @default(AGENCY)
  country       String          @db.Char(2)
  city          String
  addressLine   String          @map("address_line")
  phone         String?
  hours         String?
  publicVisible Boolean         @default(true) @map("public_visible")
  status        WarehouseStatus @default(ACTIVE)
  createdAt     DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)

  company      Company       @relation(fields: [companyId], references: [id])
  packages     Package[]
  shipments    Shipment[]
  payments     Payment[]
  cashSessions CashSession[]
  routes       Route[]

  @@unique([companyId, code])
  @@unique([id, companyId])
  @@map("agencies")
}

model Shipment {
  id                  String         @id @default(uuid(7)) @db.Uuid
  companyId           String         @map("company_id") @db.Uuid
  // <entrepôt>-<AIR|SEA>-<AAAAMMJJ>-<n> : unique par entreprise
  reference           String
  transportMode       TransportMode  @map("transport_mode")
  originWarehouseId   String         @map("origin_warehouse_id") @db.Uuid
  destinationCountry  String         @map("destination_country") @db.Char(2)
  destinationCity     String?        @map("destination_city")
  destinationAgencyId String?        @map("destination_agency_id") @db.Uuid
  carrierName         String?        @map("carrier_name")
  transportRef        String?        @map("transport_ref")
  notes               String?
  status              ShipmentStatus @default(OPEN)
  // Dates RÉELLES : saisies au moment de l'événement, jamais prévues
  departedAt          DateTime?      @map("departed_at") @db.Timestamptz(6)
  arrivedAt           DateTime?      @map("arrived_at") @db.Timestamptz(6)
  version             Int            @default(1)
  createdBy           String?        @map("created_by") @db.Uuid
  createdAt           DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)

  company   Company           @relation(fields: [companyId], references: [id])
  warehouse Warehouse         @relation(fields: [originWarehouseId, companyId], references: [id, companyId])
  agency    Agency?           @relation(fields: [destinationAgencyId, companyId], references: [id, companyId])
  packages  ShipmentPackage[]
  events    ShipmentEvent[]

  @@unique([companyId, reference])
  @@unique([id, companyId])
  @@index([companyId, status])
  @@map("shipments")
}

model ShipmentPackage {
  id         String    @id @default(uuid(7)) @db.Uuid
  companyId  String    @map("company_id") @db.Uuid
  shipmentId String    @map("shipment_id") @db.Uuid
  packageId  String    @map("package_id") @db.Uuid
  loadedAt   DateTime  @default(now()) @map("loaded_at") @db.Timestamptz(6)
  loadedBy   String?   @map("loaded_by") @db.Uuid
  removedAt  DateTime? @map("removed_at") @db.Timestamptz(6)
  removedBy  String?   @map("removed_by") @db.Uuid

  company  Company  @relation(fields: [companyId], references: [id])
  shipment Shipment @relation(fields: [shipmentId, companyId], references: [id, companyId])
  package  Package  @relation(fields: [packageId, companyId], references: [id, companyId])

  @@index([companyId, shipmentId])
  @@index([companyId, packageId])
  @@map("shipment_packages")
}

// Historique du lot : ajout seul, source toujours saisie par le personnel (aucune API de transporteur).
model ShipmentEvent {
  id          String          @id @default(uuid(7)) @db.Uuid
  companyId   String          @map("company_id") @db.Uuid
  shipmentId  String          @map("shipment_id") @db.Uuid
  eventType   String          @map("event_type")
  fromStatus  ShipmentStatus? @map("from_status")
  toStatus    ShipmentStatus? @map("to_status")
  actorUserId String?         @map("actor_user_id") @db.Uuid
  note        String?
  data        Json?
  occurredAt  DateTime        @default(now()) @map("occurred_at") @db.Timestamptz(6)

  company  Company  @relation(fields: [companyId], references: [id])
  shipment Shipment @relation(fields: [shipmentId, companyId], references: [id, companyId])

  @@index([companyId, shipmentId, occurredAt])
  @@map("shipment_events")
}

// =============================================================================================
// Phase 7 : factures, paiements, notifications
// =============================================================================================

enum InvoiceStatus {
  DRAFT
  ISSUED
  PARTIALLY_PAID
  PAID
  VOID
  CREDITED
}

enum InvoiceLineKind {
  FREIGHT
  STORAGE
  HANDLING
  INSURANCE
  TAX
  CUSTOMS
  DISCOUNT
  OTHER
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  ZELLE
  MOBILE_MONEY
  CARD_ONLINE
}

enum PaymentStatus {
  PENDING
  CONFIRMED
  FAILED
  CANCELLED
  REFUNDED_PARTIAL
  REFUNDED
}

enum NotificationChannel {
  IN_APP
  EMAIL
  SMS
  WHATSAPP
}

enum NotificationStatus {
  QUEUED
  SENT
  FAILED
  SKIPPED
}

// Montants en décimal exact. Le numéro n'est attribué qu'à l'émission (numérotation sans trou).
model Invoice {
  id              String        @id @default(uuid(7)) @db.Uuid
  companyId       String        @map("company_id") @db.Uuid
  number          String?
  customerId      String        @map("customer_id") @db.Uuid
  status          InvoiceStatus @default(DRAFT)
  currency        String        @db.Char(3)
  subtotal        Decimal       @default(0) @db.Decimal(14, 2)
  discountTotal   Decimal       @default(0) @map("discount_total") @db.Decimal(14, 2)
  taxTotal        Decimal       @default(0) @map("tax_total") @db.Decimal(14, 2)
  total           Decimal       @default(0) @db.Decimal(14, 2)
  // Avoirs émis et encaissements nets des remboursements : tenus à jour sous verrou de ligne
  creditedTotal   Decimal       @default(0) @map("credited_total") @db.Decimal(14, 2)
  paidTotal       Decimal       @default(0) @map("paid_total") @db.Decimal(14, 2)
  discountPercent Decimal?      @map("discount_percent") @db.Decimal(5, 2)
  dueDate         DateTime?     @map("due_date") @db.Date
  notes           String?
  issuedAt        DateTime?     @map("issued_at") @db.Timestamptz(6)
  voidedAt        DateTime?     @map("voided_at") @db.Timestamptz(6)
  voidReason      String?       @map("void_reason")
  createdBy       String?       @map("created_by") @db.Uuid
  version         Int           @default(1)
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  company  Company          @relation(fields: [companyId], references: [id])
  customer Customer         @relation(fields: [customerId, companyId], references: [id, companyId])
  lines    InvoiceLine[]
  packages InvoicePackage[]
  credits  CreditNote[]
  payments Payment[]

  @@unique([companyId, number])
  @@unique([id, companyId])
  @@index([companyId, customerId])
  @@index([companyId, status])
  @@map("invoices")
}

model InvoiceLine {
  id          String          @id @default(uuid(7)) @db.Uuid
  companyId   String          @map("company_id") @db.Uuid
  invoiceId   String          @map("invoice_id") @db.Uuid
  packageId   String?         @map("package_id") @db.Uuid
  kind        InvoiceLineKind
  description String
  quantity    Decimal         @default(1) @db.Decimal(10, 3)
  unitPrice   Decimal         @map("unit_price") @db.Decimal(14, 2)
  amount      Decimal         @db.Decimal(14, 2)
  position    Int

  company Company  @relation(fields: [companyId], references: [id])
  invoice Invoice  @relation(fields: [invoiceId, companyId], references: [id, companyId])
  package Package? @relation(fields: [packageId, companyId], references: [id, companyId])

  @@index([companyId, invoiceId])
  @@map("invoice_lines")
}

// Un colis n'est facturé qu'une fois : réservé par une facture (brouillon ou émise), libéré à l'annulation.
model InvoicePackage {
  id        String @id @default(uuid(7)) @db.Uuid
  companyId String @map("company_id") @db.Uuid
  packageId String @unique @map("package_id") @db.Uuid
  invoiceId String @map("invoice_id") @db.Uuid

  company Company @relation(fields: [companyId], references: [id])
  invoice Invoice @relation(fields: [invoiceId, companyId], references: [id, companyId])
  package Package @relation(fields: [packageId, companyId], references: [id, companyId])

  @@unique([packageId, companyId])
  @@index([companyId, invoiceId])
  @@map("invoice_packages")
}

model CreditNote {
  id        String   @id @default(uuid(7)) @db.Uuid
  companyId String   @map("company_id") @db.Uuid
  number    String
  invoiceId String   @map("invoice_id") @db.Uuid
  amount    Decimal  @db.Decimal(14, 2)
  reason    String
  createdBy String?  @map("created_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  company Company @relation(fields: [companyId], references: [id])
  invoice Invoice @relation(fields: [invoiceId, companyId], references: [id, companyId])

  @@unique([companyId, number])
  @@index([companyId, invoiceId])
  @@map("credit_notes")
}

// Un paiement règle UNE facture (écart assumé avec la table d'affectations de la conception).
model Payment {
  id                 String        @id @default(uuid(7)) @db.Uuid
  companyId          String        @map("company_id") @db.Uuid
  customerId         String        @map("customer_id") @db.Uuid
  invoiceId          String        @map("invoice_id") @db.Uuid
  method             PaymentMethod
  status             PaymentStatus @default(PENDING)
  currency           String        @db.Char(3)
  amount             Decimal       @db.Decimal(14, 2)
  provider           String?
  providerRef        String?       @map("provider_ref")
  // Référence lisible fournie par le client ou l'employé (n° de virement, de transaction mobile, de bordereau)
  reference          String?
  confirmedAt        DateTime?     @map("confirmed_at") @db.Timestamptz(6)
  recordedBy         String?       @map("recorded_by") @db.Uuid
  declaredByCustomer Boolean       @default(false) @map("declared_by_customer")
  agencyId           String?       @map("agency_id") @db.Uuid
  cashSessionId      String?       @map("cash_session_id") @db.Uuid
  failureReason      String?       @map("failure_reason")
  refundedTotal      Decimal       @default(0) @map("refunded_total") @db.Decimal(14, 2)
  createdAt          DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  company     Company      @relation(fields: [companyId], references: [id])
  customer    Customer     @relation(fields: [customerId, companyId], references: [id, companyId])
  invoice     Invoice      @relation(fields: [invoiceId, companyId], references: [id, companyId])
  agency      Agency?      @relation(fields: [agencyId, companyId], references: [id, companyId])
  cashSession CashSession? @relation(fields: [cashSessionId, companyId], references: [id, companyId])
  receipt     Receipt?
  refunds     Refund[]

  @@unique([provider, providerRef])
  @@unique([companyId, method, reference])
  @@unique([id, companyId])
  @@index([companyId, status])
  @@index([companyId, invoiceId])
  @@map("payments")
}

model Receipt {
  id        String   @id @default(uuid(7)) @db.Uuid
  companyId String   @map("company_id") @db.Uuid
  number    String
  paymentId String   @unique @map("payment_id") @db.Uuid
  issuedAt  DateTime @default(now()) @map("issued_at") @db.Timestamptz(6)
  issuedBy  String?  @map("issued_by") @db.Uuid

  company Company @relation(fields: [companyId], references: [id])
  payment Payment @relation(fields: [paymentId, companyId], references: [id, companyId])

  @@unique([companyId, number])
  @@unique([paymentId, companyId])
  @@map("receipts")
}

model Refund {
  id        String   @id @default(uuid(7)) @db.Uuid
  companyId String   @map("company_id") @db.Uuid
  paymentId String   @map("payment_id") @db.Uuid
  amount    Decimal  @db.Decimal(14, 2)
  reason    String
  createdBy String?  @map("created_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  company Company @relation(fields: [companyId], references: [id])
  payment Payment @relation(fields: [paymentId, companyId], references: [id, companyId])

  @@index([companyId, paymentId])
  @@map("refunds")
}

// Caisse : une session ouverte à la fois par agence (ou pour la caisse de l'entreprise).
model CashSession {
  id             String    @id @default(uuid(7)) @db.Uuid
  companyId      String    @map("company_id") @db.Uuid
  agencyId       String?   @map("agency_id") @db.Uuid
  openedBy       String?   @map("opened_by") @db.Uuid
  openedAt       DateTime  @default(now()) @map("opened_at") @db.Timestamptz(6)
  currency       String    @default("USD") @db.Char(3)
  openingAmount  Decimal   @default(0) @map("opening_amount") @db.Decimal(14, 2)
  closedAt       DateTime? @map("closed_at") @db.Timestamptz(6)
  closedBy       String?   @map("closed_by") @db.Uuid
  countedAmount  Decimal?  @map("counted_amount") @db.Decimal(14, 2)
  expectedAmount Decimal?  @map("expected_amount") @db.Decimal(14, 2)
  difference     Decimal?  @db.Decimal(14, 2)

  company  Company             @relation(fields: [companyId], references: [id])
  agency   Agency?             @relation(fields: [agencyId, companyId], references: [id, companyId])
  payments Payment[]
  deposit  BankDepositSession?

  @@unique([id, companyId])
  @@map("cash_sessions")
}

// Empêche le rejeu d'une confirmation de prestataire : (entreprise, prestataire, événement) est unique.
model ProviderWebhookEvent {
  id          String   @id @default(uuid(7)) @db.Uuid
  companyId   String   @map("company_id") @db.Uuid
  provider    String
  eventId     String   @map("event_id")
  payloadHash String   @map("payload_hash")
  status      String
  receivedAt  DateTime @default(now()) @map("received_at") @db.Timestamptz(6)

  company Company @relation(fields: [companyId], references: [id])

  @@unique([companyId, provider, eventId])
  @@map("provider_webhook_events")
}

model NotificationTemplate {
  id        String              @id @default(uuid(7)) @db.Uuid
  companyId String              @map("company_id") @db.Uuid
  eventCode String              @map("event_code")
  channel   NotificationChannel
  locale    String
  subject   String?
  body      String
  active    Boolean             @default(true)
  updatedBy String?             @map("updated_by") @db.Uuid
  updatedAt DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)

  company Company @relation(fields: [companyId], references: [id])

  @@unique([companyId, eventCode, channel, locale])
  @@map("notification_templates")
}

// Événement métier écrit DANS la transaction de l'action ; un traitement distinct le transforme en notifications.
model OutboxEvent {
  id            String    @id @default(uuid(7)) @db.Uuid
  companyId     String    @map("company_id") @db.Uuid
  eventCode     String    @map("event_code")
  aggregateType String    @map("aggregate_type")
  aggregateId   String    @map("aggregate_id") @db.Uuid
  customerId    String?   @map("customer_id") @db.Uuid
  payload       Json
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  processedAt   DateTime? @map("processed_at") @db.Timestamptz(6)
  attempts      Int       @default(0)
  lastError     String?   @map("last_error")
  nextAttemptAt DateTime  @default(now()) @map("next_attempt_at") @db.Timestamptz(6)

  company Company @relation(fields: [companyId], references: [id])

  @@index([companyId, processedAt, nextAttemptAt])
  @@map("outbox_events")
}

model Notification {
  id            String              @id @default(uuid(7)) @db.Uuid
  companyId     String              @map("company_id") @db.Uuid
  outboxEventId String?             @map("outbox_event_id") @db.Uuid
  customerId    String              @map("customer_id") @db.Uuid
  userId        String              @map("user_id") @db.Uuid
  eventCode     String              @map("event_code")
  channel       NotificationChannel
  locale        String
  subject       String?
  body          String
  status        NotificationStatus  @default(QUEUED)
  skipReason    String?             @map("skip_reason")
  attempts      Int                 @default(0)
  lastError     String?             @map("last_error")
  nextAttemptAt DateTime?           @map("next_attempt_at") @db.Timestamptz(6)
  sentAt        DateTime?           @map("sent_at") @db.Timestamptz(6)
  readAt        DateTime?           @map("read_at") @db.Timestamptz(6)
  // Une seule notification par (événement, destinataire, canal) : relire un événement ne renvoie rien
  dedupeKey     String              @map("dedupe_key")
  createdAt     DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)

  company  Company  @relation(fields: [companyId], references: [id])
  customer Customer @relation(fields: [customerId, companyId], references: [id, companyId])

  @@unique([companyId, dedupeKey])
  @@index([companyId, customerId, createdAt])
  @@index([status, nextAttemptAt])
  @@map("notifications")
}

// =============================================================================================
// Phase 8 : tournées, remise, réclamations
// =============================================================================================

enum RouteStatus {
  PLANNED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum StopStatus {
  PENDING
  DELIVERED
  FAILED
  REMOVED
}

enum DeliveryChannel {
  ROUTE
  AGENCY
}

enum AttemptOutcome {
  SUCCEEDED
  FAILED
}

enum RecipientKind {
  CUSTOMER
  BENEFICIARY
  // Destinataire d'un colis de comptoir, sans compte ni bénéficiaire enregistré
  RECIPIENT
}

enum ClaimStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  REJECTED
}

enum ClaimCategory {
  DAMAGED
  LOST
  DELAYED
  BILLING
  SERVICE
  OTHER
}

enum ClaimAuthorKind {
  CUSTOMER
  STAFF
}

// Tournée de livraison d'une agence, confiée à un livreur
model Route {
  id           String      @id @default(uuid(7)) @db.Uuid
  companyId    String      @map("company_id") @db.Uuid
  reference    String
  agencyId     String      @map("agency_id") @db.Uuid
  driverUserId String      @map("driver_user_id") @db.Uuid
  plannedDate  DateTime    @map("planned_date") @db.Date
  status       RouteStatus @default(PLANNED)
  notes        String?
  startedAt    DateTime?   @map("started_at") @db.Timestamptz(6)
  completedAt  DateTime?   @map("completed_at") @db.Timestamptz(6)
  createdBy    String?     @map("created_by") @db.Uuid
  createdAt    DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)

  company Company     @relation(fields: [companyId], references: [id])
  agency  Agency      @relation(fields: [agencyId, companyId], references: [id, companyId])
  driver  User        @relation(fields: [driverUserId, companyId], references: [id, companyId])
  stops   RouteStop[]

  @@unique([companyId, reference])
  @@unique([id, companyId])
  @@index([companyId, driverUserId, plannedDate])
  @@index([companyId, agencyId, status])
  @@map("routes")
}

model RouteStop {
  id              String     @id @default(uuid(7)) @db.Uuid
  companyId       String     @map("company_id") @db.Uuid
  routeId         String     @map("route_id") @db.Uuid
  packageId       String     @map("package_id") @db.Uuid
  customerId      String     @map("customer_id") @db.Uuid
  sequence        Int
  status          StopStatus @default(PENDING)
  // Adresse de livraison au moment de la planification (une copie : l'adresse du client peut changer ensuite)
  addressSnapshot Json       @map("address_snapshot")
  instructions    String?
  createdAt       DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)

  company  Company  @relation(fields: [companyId], references: [id])
  route    Route    @relation(fields: [routeId, companyId], references: [id, companyId])
  package  Package  @relation(fields: [packageId, companyId], references: [id, companyId])
  customer Customer @relation(fields: [customerId, companyId], references: [id, companyId])

  @@unique([routeId, packageId])
  @@unique([id, companyId])
  @@index([companyId, routeId, sequence])
  @@map("route_stops")
}

// Tentative de remise ou de livraison : ajout seul
model DeliveryAttempt {
  id                String          @id @default(uuid(7)) @db.Uuid
  companyId         String          @map("company_id") @db.Uuid
  packageId         String          @map("package_id") @db.Uuid
  routeStopId       String?         @map("route_stop_id") @db.Uuid
  channel           DeliveryChannel
  outcome           AttemptOutcome
  failureReason     String?         @map("failure_reason")
  note              String?
  rescheduleFor     DateTime?       @map("reschedule_for") @db.Date
  recipientKind     RecipientKind?  @map("recipient_kind")
  recipientName     String?         @map("recipient_name")
  beneficiaryId     String?         @map("beneficiary_id") @db.Uuid
  idDocumentType    String?         @map("id_document_type")
  // Seulement les 4 derniers caractères de la pièce
  idDocumentLast4   String?         @map("id_document_last4")
  otpVerified       Boolean         @default(false) @map("otp_verified")
  balanceOverridden Boolean         @default(false) @map("balance_overridden")
  overrideReason    String?         @map("override_reason")
  proofFileId       String?         @map("proof_file_id") @db.Uuid
  actorUserId       String?         @map("actor_user_id") @db.Uuid
  attemptedAt       DateTime        @default(now()) @map("attempted_at") @db.Timestamptz(6)

  company Company @relation(fields: [companyId], references: [id])
  package Package @relation(fields: [packageId, companyId], references: [id, companyId])

  @@index([companyId, packageId, attemptedAt])
  @@index([companyId, actorUserId, attemptedAt])
  @@map("delivery_attempts")
}

// Code de remise (6 chiffres) : seule l'empreinte est conservée ; un seul code actif par colis
model HandoverCode {
  id             String    @id @default(uuid(7)) @db.Uuid
  companyId      String    @map("company_id") @db.Uuid
  packageId      String    @map("package_id") @db.Uuid
  customerId     String    @map("customer_id") @db.Uuid
  codeHash       String    @map("code_hash")
  expiresAt      DateTime  @map("expires_at") @db.Timestamptz(6)
  failedAttempts Int       @default(0) @map("failed_attempts")
  usedAt         DateTime? @map("used_at") @db.Timestamptz(6)
  revokedAt      DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  company  Company  @relation(fields: [companyId], references: [id])
  package  Package  @relation(fields: [packageId, companyId], references: [id, companyId])
  customer Customer @relation(fields: [customerId, companyId], references: [id, companyId])

  @@index([companyId, packageId])
  @@map("handover_codes")
}

model Claim {
  id         String        @id @default(uuid(7)) @db.Uuid
  companyId  String        @map("company_id") @db.Uuid
  number     String
  customerId String        @map("customer_id") @db.Uuid
  packageId  String?       @map("package_id") @db.Uuid
  category   ClaimCategory
  subject    String
  status     ClaimStatus   @default(OPEN)
  assignedTo String?       @map("assigned_to") @db.Uuid
  resolution String?
  openedAt   DateTime      @default(now()) @map("opened_at") @db.Timestamptz(6)
  resolvedAt DateTime?     @map("resolved_at") @db.Timestamptz(6)
  updatedAt  DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  company      Company            @relation(fields: [companyId], references: [id])
  customer     Customer           @relation(fields: [customerId, companyId], references: [id, companyId])
  package      Package?           @relation(fields: [packageId, companyId], references: [id, companyId])
  assignee     User?              @relation(fields: [assignedTo, companyId], references: [id, companyId])
  messages     ClaimMessage[]
  compensation ClaimCompensation?

  @@unique([companyId, number])
  @@unique([id, companyId])
  @@index([companyId, status])
  @@index([companyId, customerId])
  @@map("claims")
}

// Message d'une réclamation : ajout seul ; une note interne n'est jamais montrée au client
model ClaimMessage {
  id           String          @id @default(uuid(7)) @db.Uuid
  companyId    String          @map("company_id") @db.Uuid
  claimId      String          @map("claim_id") @db.Uuid
  authorKind   ClaimAuthorKind @map("author_kind")
  authorUserId String?         @map("author_user_id") @db.Uuid
  body         String
  internal     Boolean         @default(false)
  createdAt    DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)

  company Company @relation(fields: [companyId], references: [id])
  claim   Claim   @relation(fields: [claimId, companyId], references: [id, companyId])

  @@index([companyId, claimId, createdAt])
  @@map("claim_messages")
}

// =============================================================================================
// Phase 9 : double authentification
// =============================================================================================

// Code de secours d'un compte à double authentification : seule l'empreinte HMAC est conservée, usage unique
model TotpRecoveryCode {
  id        String    @id @default(uuid(7)) @db.Uuid
  companyId String    @map("company_id") @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  codeHash  String    @map("code_hash")
  usedAt    DateTime? @map("used_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  company Company @relation(fields: [companyId], references: [id])
  user    User    @relation(fields: [userId, companyId], references: [id, companyId])

  @@unique([userId, codeHash])
  @@index([companyId, userId])
  @@map("totp_recovery_codes")
}

// Frais CONATEL (reversés) : table d'articles de l'entreprise
enum CustomsFeeKind {
  FIXED
  PERCENT_OF_VALUE
  PER_WATT
  TO_CONFIRM
}

model CustomsItem {
  id                    String         @id @default(uuid(7)) @db.Uuid
  companyId             String         @map("company_id") @db.Uuid
  name                  String
  size                  String         @default("")
  kind                  CustomsFeeKind
  normalPrice           Decimal?       @map("normal_price") @db.Decimal(14, 2)
  vipPrice              Decimal?       @map("vip_price") @db.Decimal(14, 2)
  rate                  Decimal?       @db.Decimal(10, 4)
  requiresAuthorization Boolean        @default(false) @map("requires_authorization")
  active                Boolean        @default(true)
  createdAt             DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)

  company Company              @relation(fields: [companyId], references: [id])
  lines   PackageCustomsLine[]

  @@unique([companyId, name, size])
  @@unique([id, companyId])
  @@map("customs_items")
}

model PackageCustomsLine {
  id            String   @id @default(uuid(7)) @db.Uuid
  companyId     String   @map("company_id") @db.Uuid
  packageId     String   @map("package_id") @db.Uuid
  itemId        String   @map("item_id") @db.Uuid
  quantity      Int      @default(1)
  vip           Boolean  @default(false)
  declaredValue Decimal? @map("declared_value") @db.Decimal(14, 2)
  watts         Decimal? @db.Decimal(12, 2)
  fee           Decimal  @db.Decimal(14, 2)
  currency      String   @db.Char(3)
  createdBy     String?  @map("created_by") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  company Company     @relation(fields: [companyId], references: [id])
  package Package     @relation(fields: [packageId, companyId], references: [id, companyId])
  item    CustomsItem @relation(fields: [itemId, companyId], references: [id, companyId])

  @@index([companyId, packageId])
  @@map("package_customs_lines")
}

model Expense {
  id          String   @id @default(uuid(7)) @db.Uuid
  companyId   String   @map("company_id") @db.Uuid
  spentOn     DateTime @map("spent_on") @db.Date
  category    String
  agency      String?
  description String
  amount      Decimal  @db.Decimal(14, 2)
  currency    String   @db.Char(3)
  createdBy   String?  @map("created_by") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  company Company @relation(fields: [companyId], references: [id])

  @@unique([id, companyId])
  @@index([companyId, spentOn])
  @@map("expenses")
}

model BankDeposit {
  id              String   @id @default(uuid(7)) @db.Uuid
  companyId       String   @map("company_id") @db.Uuid
  number          String
  depositDate     DateTime @map("deposit_date") @db.Date
  bank            String
  accountLast4    String?  @map("account_last4")
  slipRef         String   @map("slip_ref")
  currency        String   @db.Char(3)
  expectedAmount  Decimal  @map("expected_amount") @db.Decimal(14, 2)
  depositedAmount Decimal  @map("deposited_amount") @db.Decimal(14, 2)
  difference      Decimal  @db.Decimal(14, 2)
  note            String?
  createdBy       String?  @map("created_by") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  company  Company              @relation(fields: [companyId], references: [id])
  sessions BankDepositSession[]

  @@unique([companyId, number])
  @@unique([id, companyId])
  @@map("bank_deposits")
}

model PettyCashEntry {
  id           String   @id @default(uuid(7)) @db.Uuid
  companyId    String   @map("company_id") @db.Uuid
  number       String
  entryDate    DateTime @map("entry_date") @db.Date
  kind         String
  category     String?
  description  String
  counterparty String?
  receiptRef   String?  @map("receipt_ref")
  amount       Decimal  @db.Decimal(14, 2)
  currency     String   @db.Char(3)
  createdBy    String?  @map("created_by") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  company Company @relation(fields: [companyId], references: [id])

  @@unique([companyId, number])
  @@index([companyId, entryDate])
  @@map("petty_cash_entries")
}

model BankDepositSession {
  companyId     String @map("company_id") @db.Uuid
  depositId     String @map("deposit_id") @db.Uuid
  cashSessionId String @unique @map("cash_session_id") @db.Uuid

  company     Company     @relation(fields: [companyId], references: [id])
  deposit     BankDeposit @relation(fields: [depositId, companyId], references: [id, companyId])
  cashSession CashSession @relation(fields: [cashSessionId, companyId], references: [id, companyId])

  @@id([depositId, cashSessionId])
  @@unique([cashSessionId, companyId])
  @@map("bank_deposit_sessions")
}

model Referrer {
  id        String   @id @default(uuid(7)) @db.Uuid
  companyId String   @map("company_id") @db.Uuid
  name      String
  phone     String?
  email     String?
  rate      Decimal  @db.Decimal(5, 2)
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  company   Company            @relation(fields: [companyId], references: [id])
  customers CustomerReferrer[]
  payouts   ReferrerPayout[]

  @@unique([companyId, name])
  @@unique([id, companyId])
  @@map("referrers")
}

model CustomerReferrer {
  companyId  String   @map("company_id") @db.Uuid
  customerId String   @id @map("customer_id") @db.Uuid
  referrerId String   @map("referrer_id") @db.Uuid
  since      DateTime @default(now()) @db.Date

  company  Company  @relation(fields: [companyId], references: [id])
  customer Customer @relation(fields: [customerId, companyId], references: [id, companyId])
  referrer Referrer @relation(fields: [referrerId, companyId], references: [id, companyId])

  @@unique([customerId, companyId])
  @@map("customer_referrers")
}

model ReferrerPayout {
  id         String   @id @default(uuid(7)) @db.Uuid
  companyId  String   @map("company_id") @db.Uuid
  referrerId String   @map("referrer_id") @db.Uuid
  month      String
  amount     Decimal  @db.Decimal(14, 2)
  currency   String   @db.Char(3)
  paidOn     DateTime @map("paid_on") @db.Date
  note       String?
  createdBy  String?  @map("created_by") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  company  Company  @relation(fields: [companyId], references: [id])
  referrer Referrer @relation(fields: [referrerId, companyId], references: [id, companyId])

  @@unique([referrerId, month])
  @@map("referrer_payouts")
}

model ClaimCompensation {
  claimId       String    @id @map("claim_id") @db.Uuid
  companyId     String    @map("company_id") @db.Uuid
  indemnity     Decimal   @default(0) @db.Decimal(14, 2)
  reimbursement Decimal   @default(0) @db.Decimal(14, 2)
  currency      String    @db.Char(3)
  paidOn        DateTime? @map("paid_on") @db.Date
  note          String?
  updatedBy     String?   @map("updated_by") @db.Uuid
  updatedAt     DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)

  company Company @relation(fields: [companyId], references: [id])
  claim   Claim   @relation(fields: [claimId, companyId], references: [id, companyId])

  @@unique([claimId, companyId])
  @@map("claim_compensations")
}

model Proforma {
  id                 String   @id @default(uuid(7)) @db.Uuid
  companyId          String   @map("company_id") @db.Uuid
  number             String
  customerId         String   @map("customer_id") @db.Uuid
  rateCardId         String   @map("rate_card_id") @db.Uuid
  input              Json
  result             Json
  currency           String   @db.Char(3)
  total              Decimal  @db.Decimal(14, 2)
  validUntil         DateTime @map("valid_until") @db.Date
  note               String?
  convertedPackageId String?  @map("converted_package_id") @db.Uuid
  createdBy          String?  @map("created_by") @db.Uuid
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  company  Company  @relation(fields: [companyId], references: [id])
  customer Customer @relation(fields: [customerId, companyId], references: [id, companyId])
  rateCard RateCard @relation(fields: [rateCardId, companyId], references: [id, companyId])
  package  Package? @relation(fields: [convertedPackageId, companyId], references: [id, companyId])

  @@unique([companyId, number])
  @@unique([id, companyId])
  @@index([companyId, customerId, createdAt])
  @@map("proformas")
}
