                  }
                },
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": ""
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Déconnexion (cette session, ou toutes avec allSessions=true)",
        "tags": [
          "Authentification"
        ]
      }
    },
