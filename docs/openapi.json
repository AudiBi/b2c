      "post": {
        "description": "Le compte est créé en attente ; un lien d'activation (72 h) est envoyé par e-mail. Anti-escalade : les rôles attribués ne doivent pas dépasser vos propres droits.",
        "operationId": "AdminUsersController_create",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "email": {
                    "type": "string",
                    "maxLength": 254
                  },
                  "firstName": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 80
                  },
                  "lastName": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 80
                  },
                  "phone": {
                    "type": "string",
                    "pattern": "^\\+[1-9]\\d{7,14}$"
                  },
                  "locale": {
                    "default": "fr",
                    "type": "string",
                    "enum": [
                      "fr",
                      "ht",
                      "en"
                    ]
                  },
                  "roles": {
                    "minItems": 1,
                    "maxItems": 10,
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "roleCode": {
                          "type": "string",
                          "enum": [
                            "SUPER_ADMIN",
                            "COMPANY_ADMIN",
                            "LOGISTICS_MANAGER",
                            "WAREHOUSE_MANAGER",
                            "RECEPTION_AGENT",
                            "BILLING_AGENT",
                            "AGENCY_MANAGER",
                            "CUSTOMER_SERVICE",
                            "DRIVER",
                            "CUSTOMER_INDIVIDUAL",
                            "CUSTOMER_BUSINESS",
                            "AUDITOR"
                          ]
                        },
                        "scopeType": {
                          "default": "COMPANY",
                          "type": "string",
                          "enum": [
                            "COMPANY",
                            "WAREHOUSE",
                            "AGENCY",
                            "ROUTE"
                          ]
                        },
                        "scopeId": {
                          "type": "string",
                          "format": "uuid",
                          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
                        }
                      },
                      "required": [
                        "roleCode"
                      ],
                      "additionalProperties": false
                    }
                  }
                },
                "required": [
                  "email",
                  "firstName",
                  "lastName",
                  "roles"
                ],
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": ""
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Invite un membre du personnel",
        "tags": [
          "Administration : utilisateurs"
        ],
        "x-permissions": [
          "user:create"
        ]
      }
    },
