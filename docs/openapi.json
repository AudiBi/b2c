    "/v1/platform/companies": {
      "post": {
        "description": "Réservé à l'équipe de la plateforme. L'administrateur reçoit un lien d'activation par e-mail.",
        "operationId": "PlatformController_create",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 2,
                    "maxLength": 120
                  },
                  "slug": {
                    "type": "string",
                    "pattern": "^[a-z0-9](?:[a-z0-9-]{0,38}[a-z0-9])?$"
                  },
                  "trackingPrefix": {
                    "type": "string",
                    "pattern": "^[A-Z]{2,4}$"
                  },
                  "customerCodePrefix": {
                    "type": "string",
                    "pattern": "^[A-Z]{2,4}$"
                  },
                  "defaultCurrency": {
                    "default": "USD",
                    "type": "string",
                    "enum": [
                      "USD",
                      "HTG"
                    ]
                  },
                  "defaultLocale": {
                    "default": "fr",
                    "type": "string",
                    "enum": [
                      "fr",
                      "ht",
                      "en"
                    ]
                  },
                  "paymentPolicy": {
                    "default": "PAY_BEFORE_SHIPMENT",
                    "type": "string",
                    "enum": [
                      "PAY_BEFORE_SHIPMENT",
                      "PAY_BEFORE_RELEASE"
                    ]
                  },
                  "adminEmail": {
                    "type": "string",
                    "maxLength": 254
                  },
                  "adminFirstName": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 80
                  },
                  "adminLastName": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 80
                  }
                },
                "required": [
                  "name",
                  "slug",
                  "trackingPrefix",
                  "customerCodePrefix",
                  "adminEmail",
                  "adminFirstName",
                  "adminLastName"
                ],
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": ""
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Crée une entreprise et invite son administrateur",
        "tags": [
          "Plateforme"
        ],
        "x-permissions": [
          "company:manage"
        ]
      },
      "get": {
        "operationId": "PlatformController_list",
        "parameters": [],
