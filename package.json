{
  "name": "b2c",
  "private": true,
  "version": "0.1.0",
  "description": "Plateforme de logistique et d'expédition (marque : B2C — Business to Customer)",
  "engines": {
    "node": ">=22.12.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "setup:env": "node scripts/init-env.mjs",
    "doctor:db": "node scripts/doctor-db.mjs",
    "docker:up": "docker compose -f docker/compose.dev.yml --env-file .env up -d --wait",
    "docker:down": "docker compose -f docker/compose.dev.yml --env-file .env down",
    "build:shared": "npm -w @b2c/shared run build",
    "prisma:generate": "prisma generate --schema prisma/schema.prisma",
    "db:migrate": "prisma migrate deploy --schema prisma/schema.prisma",
    "db:migrate:dev": "prisma migrate dev --schema prisma/schema.prisma",
    "db:seed": "tsx prisma/seed.ts",
    "db:seed:demo": "tsx prisma/seed-demo.ts",
    "db:seed:demo-data": "tsx prisma/seed-demo-scenario.ts",
    "import:gestion": "tsx scripts/import-gestion/run.ts",
    "setup:company": "tsx scripts/setup-company/run.ts",
    "build": "npm run build:shared && npm run prisma:generate && npm -w @b2c/api run build",
    "start": "node --env-file=.env apps/api/dist/main.js",
    "docs:openapi": "npm -w @b2c/api run docs:openapi",
    "typecheck": "npm run build:shared && npm run prisma:generate && npm -w @b2c/api run typecheck && npm -w @b2c/web run typecheck && npm -w @b2c/admin run typecheck",
    "test": "npm run build:shared && npm run prisma:generate && npm -w @b2c/shared test && npm -w @b2c/api test && npm -w @b2c/web test && npm -w @b2c/admin test",
    "build:web": "npm -w @b2c/web run build",
    "seo:check": "npm -w @b2c/web run seo:check",
    "dev:api": "npm run build && node --env-file=.env apps/api/dist/main.js",
    "dev:web": "npm -w @b2c/web run dev",
    "preview:web": "npm -w @b2c/web run preview",
    "test:e2e": "npm -w @b2c/web run test:e2e",
    "loadtest": "npm run build && node scripts/loadtest/run.mjs",
    "backup:check": "node scripts/backup-restore-check.mjs",
    "s3:init": "node scripts/s3-init.mjs",
    "test:s3": "node scripts/s3-init.mjs && node scripts/test-s3.mjs",
    "setup:env:prod": "node scripts/init-env-prod.mjs",
    "prod:up": "docker compose -f docker/compose.prod.yml --env-file .env.production up -d --build",
    "prod:backup": "node scripts/prod-backup.mjs backup",
    "prod:drill": "node scripts/prod-backup.mjs drill",
    "prod:smoke": "node scripts/prod-smoke.mjs",
    "build:admin": "npm -w @b2c/admin run build",
    "dev:admin": "npm -w @b2c/admin run dev",
    "preview:admin": "npm -w @b2c/admin run preview"
  },
  "devDependencies": {
    "autocannon": "^9.0.0",
    "prisma": "6.19.3",
    "tsx": "^4.20.0",
    "typescript": "5.9.3"
  },
  "overrides": {
    "multer": "2.5.0",
    "@nestjs/swagger": {
      "js-yaml": "5.5.0"
    }
  }
}
